# ---------------------------------------------------------------------------
# Hornbach GM Checklist — environment
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Supabase Postgres (region eu-north-1, Stockholm).
# Use the POOLED connection string for the app (Vercel is serverless).
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-north-1.pooler.supabase.com:6543/postgres"
# Direct (non-pooled) connection, used only by drizzle-kit migrations.
DIRECT_DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-north-1.pooler.supabase.com:5432/postgres"

# Supabase project — Storage (checklist photos) and admin operations.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="gm-evidence"

# Session sealing (iron-session). Minimum 32 characters.
#   openssl rand -base64 32
SESSION_SECRET=""

# Server-side peppers. Rotating these invalidates existing signatures/badges.
#   openssl rand -hex 32
SIGNATURE_PEPPER=""
BADGE_PEPPER=""

# Web Push (VAPID). Generate with: npm run generate:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:gm@example.hornbach.se"

# Shared secret pg_cron uses to call POST /api/jobs/dispatch.
CRON_SECRET=""

# Store defaults.
DEFAULT_STORE_CODE="HB-SE-GM"
DEFAULT_TIMEZONE="Europe/Stockholm"
