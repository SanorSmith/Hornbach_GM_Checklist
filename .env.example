# ---------------------------------------------------------------------------
# Hornbach GM Checklist — environment
# Copy to .env.local and fill in. Never commit .env.local.
#
# The app runs WITHOUT a database: leave DATABASE_URL unset and it starts in
# demo mode, serving the committed checklist templates from memory. Set it and
# the Postgres repository takes over. Nothing else changes.
# ---------------------------------------------------------------------------

# Neon Postgres. The POOLED endpoint (-pooler in the host) for the app.
DATABASE_URL=""
# The DIRECT (non-pooled) endpoint — same host without "-pooler". Migrations
# only: drizzle-kit needs DDL and advisory locks, which the pooler will not do.
DIRECT_DATABASE_URL=""

# Neon private bucket holding checklist evidence photos (see neon.ts).
NEON_BUCKET_IMAGES="images"

# Session sealing (iron-session). Minimum 32 characters.
#   openssl rand -base64 32
SESSION_SECRET=""

# Server-side peppers. Rotating these invalidates existing signatures/badges,
# so treat them as permanent once real checklists have been signed.
#   openssl rand -hex 32
SIGNATURE_PEPPER=""
BADGE_PEPPER=""

# Web Push (VAPID). Generate with: npm run generate:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:gm@example.hornbach.se"

# Shared secret Vercel Cron presents to POST /api/jobs/*.
CRON_SECRET=""

# Store defaults.
DEFAULT_STORE_CODE="HB-SE-GM"
DEFAULT_TIMEZONE="Europe/Stockholm"
