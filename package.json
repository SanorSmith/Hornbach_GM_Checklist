{
  "name": "hornbach-gm-checklist",
  "version": "0.1.0",
  "private": true,
  "description": "Digital checklists for Hornbach GM (Godsmottagning) — guided runs, evidence, supervisor after-control and reporting.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "lint:fix": "eslint . --fix",
    "db:schema-sql": "node scripts/build-schema-sql.mjs",
    "seed": "node scripts/seed.mjs",
    "generate:vapid": "node scripts/generate-vapid.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "browser-image-compression": "2.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "iron-session": "9.0.1",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "web-push": "^3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@neon/config": "1.7.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.6.1",
    "dotenv": "18.0.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.1.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
